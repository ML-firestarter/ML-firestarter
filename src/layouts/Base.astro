---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Phrase from '../components/Phrase.astro';
import Sidebar from '../components/Sidebar.astro';
import { DEFAULT_LANG, LANGS, localizeUrl, ui, type Lang } from '../lib/i18n.ts';
import { NOTES_DIR, TESTS_PATH } from '../lib/paths.ts';
import { site } from '../site.config.ts';

interface Props {
  lang: Lang;
  /**
   * Language-neutral URL of the page, like `/vocabulary/sft/`. Highlights the page
   * in the sidebar and links to it in the other languages; error pages leave it out.
   */
  path?: string;
  /** Page title; the site name is appended. */
  title?: string;
  description?: string;
  /** Part of the site the page belongs to: picks the tab and what the sidebar lists. */
  section?: 'lessons' | 'tests';
}

const { lang, path, title, description = site.tagline[lang], section = 'lessons' } = Astro.props;
const t = ui[lang];
const tabs = [
  { section: 'lessons', path: '/', icon: 'book', label: t.lessonsTab },
  { section: 'tests', path: TESTS_PATH, icon: 'quiz', label: t.tests.title },
] as const;
const absolute = (code: Lang) => Astro.site && path && new URL(localizeUrl(path, code), Astro.site).href;
/** Signing in is for commenting on the notes, so it's there only when comments are on. */
const accounts = site.comments.length > 0;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.title}` : site.title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      absolute(lang) && (
        <>
          {LANGS.map((code) => <link rel="alternate" hreflang={code} href={absolute(code)} />)}
          <link rel="alternate" hreflang="x-default" href={absolute(DEFAULT_LANG)} />
        </>
      )
    }
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('ml-workout:theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        // Set by the API when a reader signs in with GitHub; see src/scripts/account.ts.
        if (/(?:^|;\s*)mlw_user=/.test(document.cookie)) document.documentElement.dataset.signedIn = '';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skipLink}</a>
    <header class="topbar">
      <button class="icon-button nav-button" type="button" data-nav-toggle aria-controls="sidebar" aria-expanded="false">
        <Icon name="menu" />
        <span class="visually-hidden">{t.menu}</span>
      </button>
      <a class="brand" href={localizeUrl('/', lang)}>
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span>{site.title}</span>
      </a>
      <nav class="section-tabs" aria-label={t.sections}>
        {
          tabs.map((tab) => (
            <a
              href={localizeUrl(tab.path, lang)}
              aria-current={tab.section !== section ? undefined : tab.path === path ? 'page' : 'true'}
            >
              <Icon name={tab.icon} />
              <span>{tab.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="topbar-actions">
        <a class="text-button" href={`${site.repo}/tree/${site.branch}/${NOTES_DIR}`}>
          <Icon name="book" />
          <span>{t.github}</span>
        </a>
        {
          LANGS.filter((code) => code !== lang).map((code) => (
            <a
              class="icon-button lang-link"
              href={localizeUrl(path ?? '/', code)}
              hreflang={code}
              lang={code}
              title={ui[code].readIn}
            >
              <span aria-hidden="true">{code.toUpperCase()}</span>
              <span class="visually-hidden">{ui[code].readIn}</span>
            </a>
          ))
        }
        <button class="icon-button" type="button" data-theme-toggle>
          <Icon name="moon" class="when-light" />
          <Icon name="sun" class="when-dark" />
          <span class="visually-hidden">{t.theme}</span>
        </button>
        {
          accounts && (
            <div class="account">
              <a
                class="text-button when-signed-out"
                href={`/api/auth/login?return=${encodeURIComponent(localizeUrl(path ?? '/', lang))}`}
                title={t.account.signInHint}
                data-sign-in
              >
                <Icon name="login" />
                <span>{t.account.signIn}</span>
              </a>
              <button class="icon-button account-button when-signed-in" type="button" popovertarget="account-menu" title={t.account.menu}>
                <img class="avatar" alt="" width="26" height="26" data-account-avatar />
                <span class="visually-hidden">{t.account.menu}</span>
              </button>
              <div class="account-menu" id="account-menu" popover>
                <p>
                  <Phrase text={t.account.signedInAs}>
                    <strong data-account-login></strong>
                  </Phrase>
                </p>
                <button class="button" type="button" data-sign-out>
                  <Icon name="logout" />
                  {t.account.signOut}
                </button>
              </div>
            </div>
          )
        }
      </div>
    </header>
    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <Sidebar lang={lang} current={path ?? ''} section={section} />
      </aside>
      <div class="scrim" data-nav-close></div>
      <main id="content">
        <slot />
      </main>
    </div>
    <script src="../scripts/app.ts"></script>
  </body>
</html>
