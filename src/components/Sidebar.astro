---
import { getCourse, type Chapter, type Group, type Lesson } from '../lib/course.ts';
import { ui, type Lang } from '../lib/i18n.ts';
import { NOTES_DIR, TESTS_DIR } from '../lib/paths.ts';
import Phrase from './Phrase.astro';
import TreeItem from './TreeItem.astro';

interface Props {
  lang: Lang;
  /** Language-neutral URL of the current page. */
  current: string;
  /** Language-neutral URL of the page the current one belongs to, like an exercise's lesson. */
  parent?: string;
  /** Lists the lessons, or the lessons that have a test. */
  section: 'lessons' | 'tests';
}

const { lang, current, parent, section } = Astro.props;
const t = ui[lang];
const course = await getCourse(lang);
/** Whether the tests sidebar shows the node: a lesson with a test, or a chapter with tested lessons or an exam. */
const tested = (node: Chapter | Lesson) => (node.kind === 'lesson' ? Boolean(node.test) : node.lessons.some((lesson) => lesson.test) || Boolean(node.exam));
/** The tests sidebar leaves out groups with nothing to show, so no header stands alone. */
const groups = section === 'tests' ? course.groups.filter((group) => group.nodes.some(tested)) : course.groups;
const heading = (group: Group) => (group.stage ? `${t.stageNumber(group.stage)} · ${group.title}` : group.title);
---

{
  section === 'tests' ? (
    <nav aria-label={t.tests.title}>
      <div class="course-progress" data-test-progress={JSON.stringify(course.tests.map((test) => test.lesson.path))}>
        <div class="bar"><span></span></div>
        <p><Phrase text={t.tests.passed}><strong data-progress-label>0/{course.tests.length}</strong></Phrase></p>
      </div>
      {groups.map((group) => (
        <>
          {group.title && <h2 class="tree-heading">{heading(group)}</h2>}
          <ol class="tree">
            {group.nodes.map((node) => <TreeItem node={node} lang={lang} current={current} section="tests" />)}
          </ol>
        </>
      ))}
      {course.tests.length === 0 && (
        <p class="empty">
          <Phrase text={t.tests.empty}><code>{TESTS_DIR}</code></Phrase>
        </p>
      )}
    </nav>
  ) : (
    <nav aria-label={t.lessonsNav}>
      <div class="course-progress" data-progress={JSON.stringify(course.lessons.map((lesson) => lesson.path))}>
        <div class="bar"><span></span></div>
        <p><Phrase text={t.lessonsDone}><strong data-progress-label>0/{course.lessons.length}</strong></Phrase></p>
      </div>
      {groups.map((group) => (
        <>
          {group.title && <h2 class="tree-heading">{heading(group)}</h2>}
          <ol class="tree">
            {group.nodes.map((node) => <TreeItem node={node} lang={lang} current={current} parent={parent} section="lessons" />)}
          </ol>
        </>
      ))}
      {course.lessons.length === 0 && (
        <p class="empty">
          <Phrase text={t.empty}><code>{NOTES_DIR}</code></Phrase>
        </p>
      )}
    </nav>
  )
}
