---
import type { Chapter } from '../lib/course.ts';
import { langAttr, localizeUrl, ui, type Lang } from '../lib/i18n.ts';

interface Props {
  lang: Lang;
  parents: Chapter[];
}

const { lang, parents } = Astro.props;
---

<nav class="crumbs" aria-label={ui[lang].crumbs}>
  <a href={localizeUrl('/', lang)}>{ui[lang].home}</a>
  {
    parents.map((chapter) => (
      <>
        <span class="sep" aria-hidden="true">/</span>
        <a href={chapter.url} lang={langAttr(chapter.lang, lang)}>
          {chapter.title}
        </a>
      </>
    ))
  }
</nav>
