---
import type { Chapter } from '../lib/course.ts';

interface Props {
  parents: Chapter[];
}

const { parents } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {
    parents.map((chapter) => (
      <>
        <span class="sep" aria-hidden="true">/</span>
        <a href={chapter.url}>{chapter.title}</a>
      </>
    ))
  }
</nav>
