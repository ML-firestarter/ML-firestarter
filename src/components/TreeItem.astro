---
import type { Chapter, Lesson } from '../lib/course.ts';
import Icon from './Icon.astro';

interface Props {
  node: Chapter | Lesson;
  current: string;
}

const { node, current } = Astro.props;
---

{
  node.kind === 'lesson' ? (
    <li>
      <a
        class="lesson-link"
        href={node.url}
        data-lesson={node.url}
        aria-current={node.url === current ? 'page' : undefined}
      >
        <span class="status">
          <Icon name="check" />
        </span>
        <span>{node.title}</span>
      </a>
    </li>
  ) : (
    <li>
      <details open={current.startsWith(node.url)}>
        <summary data-progress={JSON.stringify(node.lessons.map((lesson) => lesson.url))}>
          <span>{node.title}</span>
          <span class="count" data-progress-label>
            {node.lessons.length}
          </span>
        </summary>
        <ol>
          {node.intro && (
            <li>
              <a class="lesson-link overview" href={node.url} aria-current={node.url === current ? 'page' : undefined}>
                Overview
              </a>
            </li>
          )}
          {node.children.map((child) => (
            <Astro.self node={child} current={current} />
          ))}
        </ol>
      </details>
    </li>
  )
}
