---
import type { Chapter, Lesson } from '../lib/course.ts';
import { langAttr, ui, type Lang } from '../lib/i18n.ts';
import Icon from './Icon.astro';

interface Props {
  node: Chapter | Lesson;
  lang: Lang;
  /** Language-neutral URL of the current page. */
  current: string;
}

const { node, lang, current } = Astro.props;
---

{
  node.kind === 'lesson' ? (
    <li>
      <a
        class="lesson-link"
        href={node.url}
        data-lesson={node.path}
        aria-current={node.path === current ? 'page' : undefined}
      >
        <span class="status">
          <Icon name="check" />
        </span>
        <span lang={langAttr(node.lang, lang)}>{node.title}</span>
      </a>
    </li>
  ) : (
    <li>
      <details open={current.startsWith(node.path)}>
        <summary data-progress={JSON.stringify(node.lessons.map((lesson) => lesson.path))}>
          <span lang={langAttr(node.lang, lang)}>{node.title}</span>
          <span class="count" data-progress-label>
            {node.lessons.length}
          </span>
        </summary>
        <ol>
          {node.intro && (
            <li>
              <a class="lesson-link overview" href={node.url} aria-current={node.path === current ? 'page' : undefined}>
                {ui[lang].overview}
              </a>
            </li>
          )}
          {node.children.map((child) => (
            <Astro.self node={child} lang={lang} current={current} />
          ))}
        </ol>
      </details>
    </li>
  )
}
