---
import type { Chapter, Lesson } from '../lib/course.ts';
import { langAttr, ui, type Lang } from '../lib/i18n.ts';
import { testUrl } from '../lib/paths.ts';
import Icon from './Icon.astro';

interface Props {
  node: Chapter | Lesson;
  lang: Lang;
  /** Language-neutral URL of the current page. */
  current: string;
  /** Links lessons, or the tests of the lessons that have one. */
  section: 'lessons' | 'tests';
}

const { node, lang, current, section } = Astro.props;
/** Lessons with a test, inside a chapter; the tests sidebar leaves out chapters without any, unless they have an exam. */
const tested = node.kind === 'chapter' ? node.lessons.filter((lesson) => lesson.test) : [];
const exam = node.kind === 'chapter' ? node.exam : undefined;
---

{
  section === 'tests' ? (
    node.kind === 'lesson' ? (
      node.test && (
        <li>
          <a
            class="lesson-link"
            href={node.test.url}
            data-test={node.path}
            aria-current={node.test.path === current ? 'page' : undefined}
          >
            <span class="status">
              <Icon name="check" />
            </span>
            <span lang={langAttr(node.lang, lang)}>{node.title}</span>
            <span class="score-pill" data-test-score></span>
          </a>
        </li>
      )
    ) : (
      (tested.length > 0 || exam) && (
        <li>
          <details open={current.startsWith(testUrl(node.path)) || current === exam?.path}>
            <summary data-test-progress={tested.length > 0 ? JSON.stringify(tested.map((lesson) => lesson.path)) : undefined}>
              <span lang={langAttr(node.lang, lang)}>{node.title}</span>
              {tested.length > 0 && (
                <span class="count" data-progress-label>
                  {tested.length}
                </span>
              )}
            </summary>
            <ol>
              {node.children.map((child) => (
                <Astro.self node={child} lang={lang} current={current} section={section} />
              ))}
              {exam && (
                <li>
                  <a
                    class="lesson-link exam-link"
                    href={exam.url}
                    data-exam={node.path}
                    aria-current={exam.path === current ? 'page' : undefined}
                  >
                    <span class="status exam">
                      <Icon name="award" />
                    </span>
                    <span>{ui[lang].exams.exam}</span>
                    <span class="score-pill" data-exam-score></span>
                  </a>
                </li>
              )}
            </ol>
          </details>
        </li>
      )
    )
  ) : node.kind === 'lesson' ? (
    <li>
      <a
        class="lesson-link"
        href={node.url}
        data-lesson={node.path}
        aria-current={node.path === current ? 'page' : undefined}
      >
        <span class="status">
          <Icon name="check" />
        </span>
        <span lang={langAttr(node.lang, lang)}>{node.title}</span>
      </a>
    </li>
  ) : (
    <li>
      <details open={current.startsWith(node.path)}>
        <summary data-progress={JSON.stringify(node.lessons.map((lesson) => lesson.path))}>
          <span lang={langAttr(node.lang, lang)}>{node.title}</span>
          <span class="count" data-progress-label>
            {node.lessons.length}
          </span>
        </summary>
        <ol>
          {node.intro && (
            <li>
              <a class="lesson-link overview" href={node.url} aria-current={node.path === current ? 'page' : undefined}>
                {ui[lang].overview}
              </a>
            </li>
          )}
          {node.children.map((child) => (
            <Astro.self node={child} lang={lang} current={current} section={section} />
          ))}
        </ol>
      </details>
    </li>
  )
}
