---
import ChapterView from '../components/ChapterView.astro';
import LessonView from '../components/LessonView.astro';
import Base from '../layouts/Base.astro';
import { getCourse } from '../lib/course.ts';
import { LANGS, type Lang } from '../lib/i18n.ts';

/** Every lesson and chapter, once per language. */
export async function getStaticPaths() {
  const courses = await Promise.all(LANGS.map((lang) => getCourse(lang)));
  return courses.flatMap((course) =>
    [...course.lessons, ...course.chapters].map((node) => ({
      params: { slug: node.url.slice(1, -1) },
      props: { lang: course.lang, path: node.path },
    })),
  );
}

interface Props {
  lang: Lang;
  /** Language-neutral URL of the lesson or chapter. */
  path: string;
}

const { lang, path } = Astro.props;
const course = await getCourse(lang);
const node = course.byPath.get(path)!;
---

<Base lang={lang} path={path} title={node.title} description={node.description}>
  {node.kind === 'lesson' ? <LessonView course={course} lesson={node} /> : <ChapterView lang={lang} chapter={node} />}
</Base>
