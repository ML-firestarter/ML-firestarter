---
import CertificateView from '../components/CertificateView.astro';
import ChapterView from '../components/ChapterView.astro';
import ExamView from '../components/ExamView.astro';
import LessonView from '../components/LessonView.astro';
import TestsView from '../components/TestsView.astro';
import TestView from '../components/TestView.astro';
import Base from '../layouts/Base.astro';
import { getCourse } from '../lib/course.ts';
import { LANGS, localizeUrl, ui, type Lang } from '../lib/i18n.ts';
import { CERTIFICATES_PATH, TESTS_PATH } from '../lib/paths.ts';

/** Every lesson, chapter, test and exam, the tests overview and the certificate page, once per language. */
export async function getStaticPaths() {
  const courses = await Promise.all(LANGS.map((lang) => getCourse(lang)));
  return courses.flatMap((course) =>
    [
      ...course.lessons,
      ...course.chapters,
      ...course.tests,
      ...course.exams,
      { path: TESTS_PATH, url: localizeUrl(TESTS_PATH, course.lang) },
      { path: CERTIFICATES_PATH, url: localizeUrl(CERTIFICATES_PATH, course.lang) },
    ].map((node) => ({
      params: { slug: node.url.slice(1, -1) },
      props: { lang: course.lang, path: node.path },
    })),
  );
}

interface Props {
  lang: Lang;
  /** Language-neutral URL of the page. */
  path: string;
}

const { lang, path } = Astro.props;
const course = await getCourse(lang);
const t = ui[lang].tests;
const node = path === TESTS_PATH || path === CERTIFICATES_PATH ? undefined : course.byPath.get(path)!;
---

{
  path === CERTIFICATES_PATH ? (
    <Base lang={lang} path={path} title={ui[lang].certificates.title} description={ui[lang].certificates.description} section="tests" noindex>
      <CertificateView lang={lang} />
    </Base>
  ) : !node ? (
    <Base lang={lang} path={path} title={t.title} description={t.tagline} section="tests">
      <TestsView lang={lang} />
    </Base>
  ) : node.kind === 'test' ? (
    <Base
      lang={lang}
      path={path}
      title={t.pageTitle(node.title)}
      description={node.description ?? node.lesson.description}
      section="tests"
    >
      <TestView course={course} test={node} />
    </Base>
  ) : node.kind === 'exam' ? (
    <Base lang={lang} path={path} title={ui[lang].exams.pageTitle(node.title)} description={ui[lang].exams.lede} section="tests" noindex>
      <ExamView course={course} exam={node} />
    </Base>
  ) : (
    <Base lang={lang} path={path} title={node.title} description={node.description}>
      {node.kind === 'lesson' ? <LessonView course={course} lesson={node} /> : <ChapterView lang={lang} chapter={node} />}
    </Base>
  )
}
